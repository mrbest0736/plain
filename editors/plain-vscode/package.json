{
  "name": "plain-language",
  "displayName": "Plain Language",
  "description": "Plain (.pln) — a programming language written almost entirely in English words. Syntax highlighting, snippets, live friendly diagnostics and one-command running for VS Code and Cursor.",
  "version": "1.1.0",
  "publisher": "plain-lang",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#4F46E5",
    "theme": "dark"
  },
  "keywords": [
    "plain",
    "pln",
    "english",
    "beginner",
    "education"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:plain"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plain",
        "aliases": [
          "Plain",
          "plain"
        ],
        "extensions": [
          ".pln"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/file-icon.svg",
          "dark": "./assets/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "plain",
        "scopeName": "source.plain",
        "path": "./syntaxes/plain.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "plain",
        "path": "./snippets/plain.json"
      }
    ],
    "commands": [
      {
        "command": "plain.runFile",
        "title": "Plain: Run File"
      },
      {
        "command": "plain.checkFile",
        "title": "Plain: Check File"
      },
      {
        "command": "plain.restartServer",
        "title": "Plain: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Plain",
      "properties": {
        "plain.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used to run the Plain language server and programs."
        },
        "plain.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show friendly Plain syntax diagnostics while typing."
        }
      }
    }
  }
}
